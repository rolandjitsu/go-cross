# syntax=docker/dockerfile:1
ARG GO_VERSION=1.23
FROM golang:${GO_VERSION}-bookworm AS base

ARG TARGETARCH=arm64

ENV GNU_HOST_arm64=aarch64-linux-gnu
ENV GNU_HOST_arm=arm-linux-gnueabihf

RUN apt-get update && \
  apt-get --no-install-recommends install -y \
    autoconf \
    automake \
    build-essential \
    ca-certificates \
    cmake \
    git \
    pkg-config && \
  if [ "$TARGETARCH" = "arm64" ]; then \
    apt-get --no-install-recommends install -y gcc-aarch64-linux-gnu libc6-dev-arm64-cross; \
  elif [ "$TARGETARCH" = "arm" ]; then \
    apt-get --no-install-recommends install -y gcc-arm-linux-gnueabihf libc6-dev-armhf-cross; \
  fi && \
  rm -rf /var/lib/apt/lists/*

WORKDIR /code
ENV MSGPACK_DIR=/code/third_party/msgpack-c

RUN if [ "$TARGETARCH" = "arm64" ]; then \
      export CC=aarch64-linux-gnu-gcc; \
    else \
      export CC=arm-linux-gnueabihf-gcc; \
    fi && \
  git clone --depth 1 --single-branch --branch c_master https://github.com/msgpack/msgpack-c.git $MSGPACK_DIR && \
  cd $MSGPACK_DIR && \
  cmake -DCMAKE_C_COMPILER=$CC \
    -DCMAKE_SYSTEM_NAME=Linux \
    -DCMAKE_SYSTEM_PROCESSOR=${TARGETARCH} \
    -DBUILD_SHARED_LIBS=OFF \
    -DMSGPACK_BUILD_EXAMPLES=OFF \
    . && \
  make -j$(nproc)

COPY ./go.mod ./go.sum ./

RUN --mount=type=cache,target=/go/pkg/mod \
  go mod download

FROM base AS builder

WORKDIR /code

ARG TARGETARCH=arm64

ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-I$MSGPACK_DIR/include"
ENV CGO_LDFLAGS="-L$MSGPACK_DIR -lmsgpackc"
ENV GOARCH=${TARGETARCH}
ENV GOOS=linux
ENV BIN_DIR=/tmp/bin

COPY . .

RUN --mount=type=cache,target=/root/.cache/go-build \
  --mount=type=cache,target=/go/pkg/mod,ro \
  mkdir -p $BIN_DIR && \
  if [ "$TARGETARCH" = "arm64" ]; then \
    export CC=aarch64-linux-gnu-gcc; \
  else \
    export CC=arm-linux-gnueabihf-gcc GOARM=7; \
  fi && \
  go build -trimpath -ldflags="-s -w" -mod readonly \
    -o $BIN_DIR/ \
    ./cmd/...

FROM scratch
COPY --from=builder /tmp/bin /
